{
  "name": "talkwise",
  "version": "0.1.0",
  "private": true,
  "description": "Talkwise: Live AI Assistant for Calls, Meetings and Interviews",
  "main": "./out/main/index.js",
  "author": "local",
  "scripts": {
    "dev": "electron-vite dev",
    "whisper": "C:\\whisper.cpp-1.9.5\\Release\\whisper-server.exe -m C:\\whisper.cpp-1.9.5\\models\\ggml-small.bin --port 8080",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.talkwise.app",
    "productName": "Talkwise",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
